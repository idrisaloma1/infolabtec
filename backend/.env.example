# Supabase (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Long random string — used to sign admin JWTs
JWT_SECRET=change-me-to-a-long-random-string

# One-time secret required to create the first admin account via /api/auth/setup
# Remove/rotate this after the first admin is created.
SETUP_SECRET=change-me-too

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://infolabtechbridge.com

PORT=4000
